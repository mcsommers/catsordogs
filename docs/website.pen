                  "name": "Question",
                  "fill": "$white",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "What happens if someone reports my video?",
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "fCWLv",
                  "name": "Answer",
                  "fill": "$text-dark-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "After enough distinct reports, that answer is hidden from other people’s feeds. Your account stays active; you’re notified and pointed to Help & Support.",
                  "lineHeight": 1.45,
                  "fontFamily": "$font-body",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
