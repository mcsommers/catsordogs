                {
                  "type": "text",
                  "id": "o5vHRZ",
                  "name": "Answer",
                  "fill": "$text-dark-muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "No. The app never reveals follower identities, only that you follow someone. You can turn off followers entirely in Privacy & Safety.",
