                  "name": "Question",
                  "fill": "$white",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Can someone see who follows them?",
                  "fontFamily": "$font-body",
                  "fontSize": 16,
                  "fontWeight": "600"
