---
import LegalDocument from '../components/LegalDocument.astro';
import { privacyPolicy } from '../data/legal/privacy-policy';
import { siteName } from '../data/homepage';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title={`${privacyPolicy.title} | ${siteName}`}
  description={privacyPolicy.metaDescription}
>
  <LegalDocument document={privacyPolicy} />
</SiteLayout>
