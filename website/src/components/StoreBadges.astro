---
import appStoreBadge from '../../assets/appstore.png';
import googlePlayBadge from '../../assets/googleplay.png';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['store-badges', className]}>
  <button type="button" class="store-badge-btn" data-open-download-modal aria-label="Download on the App Store">
    <img
      class="store-badge"
      src={appStoreBadge.src}
      width={appStoreBadge.width}
      height={appStoreBadge.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </button>
  <button type="button" class="store-badge-btn" data-open-download-modal aria-label="Get it on Google Play">
    <img
      class="store-badge"
      src={googlePlayBadge.src}
      width={googlePlayBadge.width}
      height={googlePlayBadge.height}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </button>
</div>
