---
import {
  downloadModal,
  testFlightAppStoreUrl,
  testFlightInviteUrl,
  testFlightModal,
} from '../data/homepage';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---

<div
  class="download-modal"
  id="download-modal"
  data-open="false"
  data-mode="android"
  aria-hidden="true"
  data-supabase-url={supabaseUrl}
  data-supabase-anon-key={supabaseAnonKey}
>
  <button type="button" class="download-modal__backdrop" id="download-modal-backdrop" tabindex="-1" aria-label="Close dialog"></button>
  <div
    class="download-modal__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="download-modal-title"
    aria-describedby="download-modal-desc"
  >
    <button type="button" class="download-modal__close" id="download-modal-close" aria-label="Close">×</button>

    <div class="download-modal__view" id="download-modal-view-android" hidden>
      <h2 id="download-modal-title" class="download-modal__title">{downloadModal.title}</h2>
      <p id="download-modal-desc" class="download-modal__message">{downloadModal.message}</p>

      <form class="download-modal__form" id="download-modal-form" novalidate>
        <label class="download-modal__label" for="download-modal-email">{downloadModal.emailLabel}</label>
        <input
          class="download-modal__input"
          type="email"
          id="download-modal-email"
          name="email"
          autocomplete="email"
          inputmode="email"
          required
        />
        <p class="download-modal__feedback" id="download-modal-feedback" hidden></p>
        <button class="download-modal__submit" type="submit">{downloadModal.submitLabel}</button>
      </form>

      <p class="download-modal__success" id="download-modal-success" hidden>{downloadModal.successMessage}</p>
    </div>

    <div class="download-modal__view" id="download-modal-view-ios" hidden>
      <h2 class="download-modal__title" id="download-modal-ios-title">{testFlightModal.title}</h2>
      <p class="download-modal__message" id="download-modal-ios-desc">{testFlightModal.intro}</p>

      <ol class="download-modal__steps">
        {
          testFlightModal.steps.map((step, index) => (
            <li class="download-modal__step">
              <span class="download-modal__step-num">{index + 1}</span>
              <div>
                <p class="download-modal__step-title">{step.title}</p>
                <p class="download-modal__step-body">{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="download-modal__ios-actions">
        <a
          class="download-modal__submit download-modal__submit--link download-modal__submit--app-store"
          id="download-modal-ios-get-testflight"
          href={testFlightAppStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {testFlightModal.getTestFlightButtonLabel}
        </a>

        <a
          class="download-modal__submit download-modal__submit--link"
          id="download-modal-ios-invite"
          href={testFlightInviteUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          {testFlightModal.inviteButtonLabel}
        </a>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ downloadModal, supabaseUrl, supabaseAnonKey }}>
  (function () {
  const modal = document.getElementById('download-modal');
  const backdrop = document.getElementById('download-modal-backdrop');
  const closeBtn = document.getElementById('download-modal-close');
  const form = document.getElementById('download-modal-form');
  const emailInput = document.getElementById('download-modal-email');
  const feedback = document.getElementById('download-modal-feedback');
  const success = document.getElementById('download-modal-success');
  const viewAndroid = document.getElementById('download-modal-view-android');
  const viewIos = document.getElementById('download-modal-view-ios');
  const iosInvite = document.getElementById('download-modal-ios-invite');
  const iosGetTestFlight = document.getElementById('download-modal-ios-get-testflight');

  if (
    !modal ||
    !backdrop ||
    !closeBtn ||
    !form ||
    !emailInput ||
    !feedback ||
    !success ||
    !viewAndroid ||
    !viewIos
  ) {
    return;
  }

  let lastFocused = null;

  function setFeedback(message, isError) {
    feedback.hidden = !message;
    feedback.textContent = message;
    feedback.classList.toggle('download-modal__feedback--error', Boolean(isError));
  }

  function showView(mode) {
    const isIos = mode === 'ios';
    modal.dataset.mode = isIos ? 'ios' : 'android';
    viewAndroid.hidden = isIos;
    viewIos.hidden = !isIos;
    modal.classList.toggle('download-modal--ios', isIos);
  }

  function openModal(mode) {
    lastFocused = document.activeElement;
    showView(mode === 'ios' ? 'ios' : 'android');
    modal.dataset.open = 'true';
    modal.setAttribute('aria-hidden', 'false');
    const panel = modal.querySelector('.download-modal__panel');
    if (panel) {
      panel.setAttribute(
        'aria-labelledby',
        mode === 'ios' ? 'download-modal-ios-title' : 'download-modal-title',
      );
      panel.setAttribute(
        'aria-describedby',
        mode === 'ios' ? 'download-modal-ios-desc' : 'download-modal-desc',
      );
    }
    document.body.style.overflow = 'hidden';

    if (mode === 'ios') {
      const focusTarget = iosGetTestFlight || iosInvite || closeBtn;
      focusTarget.focus();
    } else {
      form.hidden = false;
      success.hidden = true;
      setFeedback('', false);
      emailInput.value = '';
      emailInput.focus();
    }
  }

  function closeModal() {
    modal.dataset.open = 'false';
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
  }

  function isValidEmail(value) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value.trim());
  }

  async function submitEmail(email) {
    const url = supabaseUrl || modal.dataset.supabaseUrl;
    const key = supabaseAnonKey || modal.dataset.supabaseAnonKey;
    if (!url || !key) throw new Error('not_configured');

    const res = await fetch(`${url.replace(/\/$/, '')}/rest/v1/rpc/submit_website_launch_notify`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        apikey: key,
        Authorization: `Bearer ${key}`,
      },
      body: JSON.stringify({ p_email: email.trim() }),
    });

    if (!res.ok) {
      const body = await res.json().catch(() => ({}));
      if (body?.code === '22023' || body?.message?.includes('Invalid email')) {
        throw new Error('invalid');
      }
      throw new Error('submit');
    }
  }

  document.querySelectorAll('[data-open-download-modal]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const mode = trigger.getAttribute('data-open-download-modal') || 'android';
      openModal(mode);
    });
  });

  backdrop.addEventListener('click', closeModal);
  closeBtn.addEventListener('click', closeModal);

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && modal.dataset.open === 'true') closeModal();
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = emailInput.value.trim();
    if (!isValidEmail(email)) {
      setFeedback(downloadModal.errorInvalid, true);
      emailInput.focus();
      return;
    }

    setFeedback('', false);
    const submitBtn = form.querySelector('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;

    try {
      await submitEmail(email);
      form.hidden = true;
      success.hidden = false;
    } catch (err) {
      if (err.message === 'not_configured') {
        setFeedback(downloadModal.errorNotConfigured, true);
      } else if (err.message === 'invalid') {
        setFeedback(downloadModal.errorInvalid, true);
      } else {
        setFeedback(downloadModal.errorGeneric, true);
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
  })();
</script>
