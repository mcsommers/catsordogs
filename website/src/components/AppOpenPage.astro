---
interface Props {
  /** In-app path, e.g. /chat/uuid or /question */
  appPath: string;
  title: string;
  lead: string;
  /** Shown under the main hint when the visitor may be on desktop mail. */
  desktopHint?: string;
  /** Optional line before the Open in the app button (e.g. after email unsubscribe). */
  settingsNote?: string;
  openButtonLabel?: string;
  /** Read ?type= on /email-unsubscribed (static build has no query at build time). */
  leadFromUnsubscribeQuery?: boolean;
  /** Do not auto-launch the app on load (unsubscribe confirmation). */
  skipAutoOpen?: boolean;
}

const {
  appPath,
  title,
  lead,
  desktopHint,
  settingsNote,
  openButtonLabel = 'Open in the app',
  leadFromUnsubscribeQuery = false,
  skipAutoOpen = false,
} = Astro.props;
const site = Astro.site?.href?.replace(/\/$/, '') ?? 'https://catsordogs.net';
const httpsUrl = `${site}${appPath}`;
const schemePath = appPath.replace(/^\//, '');
const appUrl = `catsordogs://${schemePath}`;
const androidIntent = `intent://${site.replace(/^https:\/\//, '')}${appPath}#Intent;scheme=https;package=net.catsordogs.app;end`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Cats or Dogs?</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      :root {
        color-scheme: dark;
        font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
        background: #0b0b0c;
        color: #fff;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        box-sizing: border-box;
      }
      main {
        max-width: 28rem;
        text-align: center;
      }
      h1 {
        font-size: 1.5rem;
        margin: 0 0 0.75rem;
      }
      p {
        margin: 0 0 1.5rem;
        line-height: 1.5;
        color: #c8c8cc;
      }
      a.btn {
        display: inline-block;
        padding: 0.85rem 1.25rem;
        border-radius: 999px;
        background: #ff6b35;
        color: #0b0b0c;
        font-weight: 600;
        text-decoration: none;
      }
      a.btn:focus-visible {
        outline: 2px solid #fff;
        outline-offset: 2px;
      }
      .hint {
        margin-top: 1rem;
        font-size: 0.875rem;
        color: #888;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p id="lead">{lead}</p>
      {settingsNote ? <p>{settingsNote}</p> : null}
      <a class="btn" id="open-app" href={httpsUrl}>{openButtonLabel}</a>
      <p class="hint">If nothing happens, install Cats or Dogs? from the App Store or Google Play, then try again.</p>
      {desktopHint ? <p class="hint">{desktopHint}</p> : null}
    </main>
    <script define:vars={{ appUrl, androidIntent, httpsUrl, leadFromUnsubscribeQuery, skipAutoOpen }}>
      if (leadFromUnsubscribeQuery) {
        const labels = {
          daily_question: 'Daily question',
          matches: 'Matches',
          messages: 'Messages',
          nudges: 'Nudges',
        };
        const raw = new URLSearchParams(window.location.search).get('type') || '';
        const allowed = ['daily_question', 'matches', 'messages', 'nudges', 'all'];
        const type = allowed.includes(raw) ? raw : '';
        let sentence = 'You are unsubscribed from these Cats or Dogs? emails.';
        if (type === 'all') {
          sentence = 'You are unsubscribed from all Cats or Dogs? notification emails.';
        } else if (labels[type]) {
          sentence = 'You are unsubscribed from Cats or Dogs? emails regarding ' + labels[type] + '.';
        }
        const leadEl = document.getElementById('lead');
        if (leadEl) leadEl.textContent = sentence;
      }
      const isAndroid = /Android/i.test(navigator.userAgent);
      const openApp = () => {
        if (isAndroid) {
          window.location.href = androidIntent;
          return;
        }
        window.location.href = appUrl;
        window.setTimeout(() => {
          window.location.href = httpsUrl;
        }, 1200);
      };
      document.getElementById('open-app')?.addEventListener('click', (e) => {
        e.preventDefault();
        openApp();
      });
      if (!skipAutoOpen) openApp();
    </script>
  </body>
</html>
