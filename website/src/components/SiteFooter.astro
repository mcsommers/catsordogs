---
import { footer, footerLegalLinks, siteName } from '../data/homepage';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <a class="site-footer__logo" href="/">{siteName}</a>
    <ul class="site-footer__legal" aria-label="Legal and support">
      {
        footerLegalLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
    <p class="site-footer__copy">{footer.copyright}</p>
  </div>
</footer>
