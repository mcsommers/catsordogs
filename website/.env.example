# Canonical URL for sitemap, Open Graph, and JSON-LD (no trailing slash).
# Example: https://catsordogs.net
PUBLIC_SITE_URL=https://catsordogs.net

# Universal / app links (optional until store builds are live). Apple Team ID from developer.apple.com → Membership.
# PUBLIC_IOS_TEAM_ID=
# Android SHA-256 cert fingerprints from Play Console or `eas credentials` (comma-separated).
# PUBLIC_ANDROID_SHA256_CERT_FINGERPRINTS=

# Production Supabase for the public site (anon key is safe to expose in the browser).
# Use Cats or Dogs - Production (`fvnbcofflierdlnnglko`), not staging. Mobile UAT stays on staging.
PUBLIC_SUPABASE_URL=https://fvnbcofflierdlnnglko.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
