{
  "expo": {
    "name": "Cats or Dogs?",
    "slug": "cats-or-dogs",
    "version": "1.0.0",
    "scheme": "catsordogs",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Cats or Dogs? uses your camera to record your answer to the daily question.",
          "microphonePermission": "Cats or Dogs? uses your microphone so your answer has sound and captions.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cats or Dogs? uses your photos so you can add them to your profile."
        }
      ],
      "expo-notifications",
      "react-native-quick-crypto"
    ]
  }
}
