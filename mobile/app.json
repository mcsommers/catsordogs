{
  "expo": {
    "name": "Cats or Dogs?",
    "slug": "cats-or-dogs",
    "version": "1.0.0",
    "scheme": "catsordogs",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "net.catsordogs.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:catsordogs.net"
      ],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "net.catsordogs.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "catsordogs.net",
              "pathPrefix": "/question"
            },
            {
              "scheme": "https",
              "host": "catsordogs.net",
              "pathPrefix": "/chat"
            },
            {
              "scheme": "https",
              "host": "catsordogs.net",
              "pathPrefix": "/user"
            },
            {
              "scheme": "https",
              "host": "catsordogs.net",
              "pathPrefix": "/matches"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-router",
        {
          "origin": "https://catsordogs.net"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      [
        "expo-camera",
        {
          "cameraPermission": "Cats or Dogs? uses your camera to record your answer to the daily question.",
          "microphonePermission": "Cats or Dogs? uses your microphone so your answer has sound and captions.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cats or Dogs? uses your photos so you can add them to your profile."
        }
      ],
      "expo-notifications",
      "react-native-quick-crypto"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50bf2ee6-7e99-4f00-960c-46123308779e"
      }
    },
    "owner": "mcsommers"
  }
}
