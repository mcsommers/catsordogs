# Copy this file to admin/.env and fill in the values for the backend you are using.
# These are the public project URL and the public anon key (same as mobile/.env for that environment).
# Never commit admin/.env.
#
# Local: from `npm run db:start` (http://127.0.0.1:54321).
# Staging hosted admin: https://admin-staging.catsordogs.net/admin/ (staging project keys).
# Production hosted admin: https://admin.catsordogs.net/admin/ (production project keys).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
