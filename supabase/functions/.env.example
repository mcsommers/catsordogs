# Server-side settings for the Edge Functions (Mux). Copy to supabase/functions/.env
# and fill in. NEVER commit the filled-in file, and never paste these values into chat.
# For the hosted Supabase projects, set the same names with:
#   npx supabase secrets set --env-file supabase/functions/.env --project-ref <project id>

# Mux > Settings > Access Tokens (one per Mux environment)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Mux > Settings > Webhooks > your webhook's "Signing secret"
MUX_WEBHOOK_SECRET=
# Mux > Settings > Signing Keys: the key's ID, and its private key (the long base64 text Mux shows once)
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=
# Optional: "true" makes Mux create free TEST videos (watermarked, 10 seconds max, deleted after 24 hours).
# Handy for plumbing checks on staging; leave unset for real recordings.
MUX_TEST_MODE=
