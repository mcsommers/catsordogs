# Server-side settings for the Edge Functions (Mux). Make one copy per environment:
# supabase/functions/.env.staging and supabase/functions/.env.production, and fill each in
# with that Mux environment's values. NEVER commit the filled-in files, and never paste
# these values into chat. Send each to its matching Supabase project with:
#   npx supabase secrets set --env-file supabase/functions/.env.staging --project-ref <project id>

# Mux > Settings > Access Tokens (one per Mux environment)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Mux > Settings > Webhooks > your webhook's "Signing secret"
MUX_WEBHOOK_SECRET=
# Mux > Settings > Signing Keys: the key's ID, and its private key (the long base64 text Mux shows once)
MUX_SIGNING_KEY=
MUX_PRIVATE_KEY=
# Staging only: "true" makes Mux create free TEST videos (watermarked, 10 seconds max, deleted after 24 hours).
# Leave it out or set "false" in production.
MUX_TEST_MODE=

# Email (Resend). Resend > API Keys: create a key for sending. Never paste it into chat.
RESEND_API_KEY=
# The sender. Must be on the domain you verified in Resend (catsordogs.net).
RESEND_FROM=Cats or Dogs? <noreply@catsordogs.net>
# Two long random secrets you make up (for example: openssl rand -hex 32). One lets the database call the
# notification worker; the other signs the email unsubscribe links. Use different values per environment.
NOTIFICATION_WORKER_SECRET=
UNSUBSCRIBE_SECRET=
# Optional: Expo push access token, if you turn on "enhanced push security" in your Expo account.
EXPO_ACCESS_TOKEN=

# Optional: the city lookup service used for distance (see README, "City lookup"). Leave blank to use the free default.
GEOCODING_URL=
